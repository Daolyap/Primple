{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terrain Map Generator Configuration",
  "description": "Example configuration file for terrain map generation",
  
  "input": {
    "file": "elevation_data.asc",
    "format": "auto"
  },
  
  "output": {
    "file": "terrain_model.stl",
    "format": "stl",
    "binary": true
  },
  
  "dimensions": {
    "width_mm": 150,
    "height_mm": 150,
    "max_height_mm": 30
  },
  
  "terrain": {
    "vertical_exaggeration": 2.0,
    "normalize_elevation": true,
    "apply_smoothing": false,
    "smoothing_radius": 1
  },
  
  "base": {
    "type": "flat",
    "thickness_mm": 3.0,
    "min_wall_thickness_mm": 0.8
  },
  
  "edge": {
    "type": "vertical",
    "bevel_angle": 45
  },
  
  "mesh": {
    "resolution": 1.0,
    "validate": true
  },
  
  "printer": {
    "profile": "X1C",
    "auto_constrain": true
  },
  
  "features": {
    "contours": {
      "enabled": false,
      "interval_m": 100,
      "major_interval_m": 500,
      "line_width_mm": 0.5,
      "emboss": false,
      "depth_mm": 0.3
    },
    
    "hydrography": {
      "enabled": false,
      "detect_rivers": true,
      "detect_lakes": true,
      "carve_depth_mm": 1.0
    },
    
    "labels": {
      "enabled": false,
      "max_peaks": 5,
      "min_prominence_m": 100,
      "font_size_mm": 3.0,
      "include_elevation": true,
      "emboss": true
    }
  },
  
  "export_3mf": {
    "enabled": false,
    "title": "Mountain Terrain",
    "colors": true,
    "color_gradient": [
      { "position": 0.0, "color": "#228B22" },
      { "position": 0.3, "color": "#9ACD32" },
      { "position": 0.5, "color": "#D2B48C" },
      { "position": 0.7, "color": "#8B5A2B" },
      { "position": 0.9, "color": "#A9A9A9" },
      { "position": 1.0, "color": "#FFFFFF" }
    ]
  }
}
